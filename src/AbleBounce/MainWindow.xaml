<Window x:Class="AbleBounce.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AbleBounce"
        Title="AbleBounce" Width="1280" Height="860" MinWidth="1060" MinHeight="740" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="104"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource GreenBrush}" Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0">
            <Path Data="M 8,23 L 8,13 M 15,25 L 15,8 M 22,22 L 22,14 M 29,25 L 29,10" Stroke="#D7F36B" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Border>
          <TextBlock Text="AbleBounce" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Connection}" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="12,0,18,0"/>
        <Button Grid.Column="2" Content="Setup" IsEnabled="{Binding Idle}" Click="Setup_Click" Margin="0,0,10,0" VerticalAlignment="Center">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Install Live bridge…" Click="InstallBridge_Click"/>
            <MenuItem Header="Calibrate export…" Click="Calibrate_Click"/>
            <Separator/>
            <MenuItem Header="Restore working Set" Click="Restore_Click"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
        <Button Grid.Column="3" Content="Connect to Live" Click="Connect_Click" IsEnabled="{Binding Idle}" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Background="#F0F1EA">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="22,24,18,16">
            <TextBlock Text="Track roles" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding TrackSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,12"/>
            <TextBlock Text="Choose Lead, Backing or Instrument. Children can inherit their group's role." Foreground="{StaticResource MutedBrush}" FontSize="12"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tracks}" IsEnabled="{Binding Idle}" Margin="12,0,12,12">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,9">
                  <Grid Margin="{Binding Indent}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Rectangle Width="7" Height="7" Fill="{Binding TrackBrush}" HorizontalAlignment="Left"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/>
                    </Grid>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1" ItemsSource="{x:Static local:TrackRow.RoleOptions}" SelectedItem="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Foreground="{Binding RoleBrush}" FontSize="12" MinHeight="30" Padding="6,3" AutomationProperties.Name="Track role"/>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="20,12,20,18">
            <Button Content="Mark remaining as Instrument" Click="MarkRemaining_Click" FontSize="11" Padding="8,7" IsEnabled="{Binding CanExport}"/>
            <TextBlock Text="Name-based suggestions need your review. Group contents are never trimmed twice." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="26,24,26,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
          <TextBlock Text="{Binding Project}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          <TextBlock Text="One session. Every version you need." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10">
          <TextBlock Text="Delivery queue" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding Idle}">
            <Button Content="All" Click="SelectAll_Click" MinHeight="26" Padding="8,3" FontSize="11"/>
            <Button Content="None" Click="SelectNone_Click" MinHeight="26" Padding="8,3" FontSize="11" Margin="6,0,0,0"/>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Deliveries}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border x:Name="Row" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,4" ToolTip="{Binding Description}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding DataContext.Idle, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"/>
                  <StackPanel Grid.Column="1" Margin="4,0,8,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <TextBlock Text="{Binding Vocals}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Text=" · Master: " FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Text="{Binding Master}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="11" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
              </Border>
              <DataTemplate.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="Row" Property="Background" Value="#EFF3DE"/></DataTrigger></DataTemplate.Triggers>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="3" Background="#E7ECE1" CornerRadius="7" Padding="12" Margin="0,14,0,0">
          <TextBlock Text="Your original Set stays untouched. AbleBounce renders a separate working copy and restores it after each pass." Foreground="#354B3C" FontSize="12"/>
        </Border>
      </Grid>

      <Border Grid.Column="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="20,24,20,18">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Export settings" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,22"/>
            <StackPanel IsEnabled="{Binding Idle}">
              <TextBlock Text="Format" Style="{StaticResource Label}"/>
              <TextBlock Text="WAV · Stereo" FontWeight="SemiBold" Margin="0,0,0,18"/>
              <TextBlock Text="Bit depth" Style="{StaticResource Label}"/>
              <ComboBox ItemsSource="{Binding BitDepths}" SelectedItem="{Binding BitDepth}" Margin="0,0,0,18" AutomationProperties.Name="Export bit depth"/>
              <TextBlock Text="Sample rate &amp; render range" Style="{StaticResource Label}"/>
              <TextBlock Text="Use Live's Export dialog" FontWeight="SemiBold"/>
              <TextBlock Text="Set start, length, tails and sample rate once in Live. Every pass reuses them." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,18"/>
              <TextBlock Text="Dither" Style="{StaticResource Label}"/>
              <TextBlock Text="No Dither" FontWeight="SemiBold"/>
              <TextBlock Text="Normalization stays off. Levels and pan are preserved." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,18"/>
              <TextBlock Text="Save exports to" Style="{StaticResource Label}"/>
              <TextBox Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" TextWrapping="Wrap" AutomationProperties.Name="Export folder"/>
              <Button Content="Choose folder…" Click="ChooseFolder_Click" Margin="0,8,0,22"/>
              <Separator Background="{StaticResource LineBrush}" Margin="0,0,0,18"/>
              <Button Content="Install Live bridge…" Click="InstallBridge_Click" Margin="0,0,0,8"/>
              <Button Content="Calibrate export…" Click="Calibrate_Click" Margin="0,0,0,8"/>
              <Button Content="Restore working Set" Click="Restore_Click" Margin="0,0,0,14"/>
              <TextBlock Text="Lead trim is applied at each selected root. Descendant sends that bypass a selected group keep their level. Dry vocals retain Warp, edits, Clip Gain, faders and pan." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"/>
              <Button Content="View activity" Click="Activity_Click" MinHeight="32" FontSize="12" Padding="8,5"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource GreenBrush}" Padding="26,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
          <TextBlock Text="{Binding Summary}" Foreground="#E2F0E2" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Text="{Binding Status}" Foreground="#C8D9CB" FontSize="12" Margin="0,6,0,0" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel &amp; restore" Click="Cancel_Click" IsEnabled="{Binding Busy}" Background="Transparent" Foreground="#ECF4EC" BorderBrush="#59766B" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button Grid.Column="2" Content="Export selected" Click="Export_Click" IsEnabled="{Binding CanExport}" Style="{StaticResource PrimaryButton}" Padding="24,13" VerticalAlignment="Center" MinWidth="164"/>
      </Grid>
    </Border>
  </Grid>
</Window>
