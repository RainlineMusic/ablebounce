<Window x:Class="AbleBounce.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AbleBounce"
 Title="glucose" Width="1100" Height="780" MinWidth="900" MinHeight="650"
 Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" WindowStartupLocation="CenterScreen">
 <Grid Margin="10" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
   <Button Content="Install" Width="90" Padding="8,4" Margin="0,0,8,0" Click="InstallBridge_Click" IsEnabled="{Binding Idle}"/>
   <Button Content="Connect" Width="90" Padding="8,4" Margin="0,0,8,0" Click="Connect_Click" IsEnabled="{Binding Idle}"/>
   <Button Content="Calibrate" Width="90" Padding="8,4" Margin="0,0,14,0" Click="Calibrate_Click" IsEnabled="{Binding CanExport}"/>
   <TextBlock Text="{Binding Connection}" VerticalAlignment="Center"/>
  </StackPanel>
  <TextBlock Grid.Row="1" Text="{Binding Project}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <GroupBox Header="Track roles">
    <DockPanel Margin="6">
     <Button DockPanel.Dock="Bottom" Content="Mark remaining as Instrument" Click="MarkRemaining_Click" IsEnabled="{Binding CanExport}" Padding="6,3" Margin="0,6,0,0"/>
     <DataGrid ItemsSource="{Binding Tracks}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
      IsEnabled="{Binding Idle}" IsReadOnly="True" HeadersVisibility="Column" EnableRowVirtualization="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="35"/>
       <DataGridTemplateColumn Header="Track" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <TextBlock Text="{Binding Name}" Margin="{Binding Indent}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Role" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <ComboBox ItemsSource="{x:Static local:TrackRow.RoleOptions}" SelectedItem="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Track role"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="DRY" Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <CheckBox IsChecked="{Binding Dry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanDry}" HorizontalAlignment="Center" ToolTip="Export this track without processing"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </GroupBox>
   <GroupBox Grid.Column="2" Header="Export variants">
    <DockPanel Margin="6">
     <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding Idle}">
      <Button Content="All" Width="60" Margin="0,0,6,0" Click="SelectAll_Click"/>
      <Button Content="None" Width="60" Click="SelectNone_Click"/>
     </StackPanel>
     <DataGrid ItemsSource="{Binding Deliveries}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsEnabled="{Binding Idle}" HeadersVisibility="Column">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="Export" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Title}"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Variant" Binding="{Binding Title}" IsReadOnly="True" Width="*"/>
       <DataGridTextColumn Header="State" Binding="{Binding State}" IsReadOnly="True" Width="80"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </GroupBox>
  </Grid>
  <GroupBox Grid.Row="3" Header="Export settings" Margin="0,8,0,0" IsEnabled="{Binding Idle}">
   <Grid Margin="6">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Grid.Row="1" Text="Track title" VerticalAlignment="Center" Margin="0,8,6,0"/>
    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,8,0,0" Text="{Binding TrackTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Track title" ToolTip="Used in exported filenames. Leave blank to use the Live Set name."/>


    <TextBlock Grid.Column="0" Text="Output folder" VerticalAlignment="Center" Margin="14,0,6,0"/>
    <TextBox Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Export folder"/>
    <Button Grid.Column="4" Content="Browse..." Click="ChooseFolder_Click" Margin="6,0,0,0" Padding="8,3"/>
   </Grid>
  </GroupBox>
  <GroupBox Grid.Row="4" Header="Set these manually in Live" Margin="0,8,0,0">
   <TextBlock Margin="6" TextWrapping="Wrap" Text="WAV, stereo, PCM On, No Dither. Normalize, Convert to Mono, Render as Loop, MP3 and Include Return and Main Effects: Off. Set sample rate, Render Start and Render Length (including tails). These options are not changed or verified by glucose."/>
  </GroupBox>
  <DockPanel Grid.Row="5" Margin="0,10,0,0">
   <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
    <Button Content="Export selected" Click="Export_Click" IsEnabled="{Binding CanExport}" Padding="10,5" Margin="0,0,8,0"/>
    <Button x:Name="CancelButton" Content="Cancel &amp; restore" Click="Cancel_Click" IsEnabled="{Binding ExportRunning}" Padding="10,5" Margin="0,0,8,0"/>
    <Button Content="Restore Set" Click="Restore_Click" IsEnabled="{Binding Idle}" Padding="10,5" Margin="0,0,8,0"/>
    <Button Content="Activity" Click="Activity_Click" Padding="10,5"/>
   </StackPanel>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="42"/>
  </DockPanel>
 </Grid>
</Window>

